# Required server-only credentials. Run ./dev setup to create your local .env.
ANTHROPIC_API_KEY=
CONTO_ORG_API_KEY=
CONTO_OWNER_MEMBERSHIP_ID=
CONTO_SHARED_WALLET_ID=
# ./dev setup generates this locally; never use a shared example value.
SHOPPING_SESSION_ENCRYPTION_KEY=
STRIPE_TEST_SECRET_KEY=

# Optional. The launcher defaults SHOPPING_AGENT_ORIGIN to http://localhost:8000.
CONTO_API_URL=https://conto.finance
# SHOPPING_AGENT_ORIGIN=https://your-shopping-app.example.com
# Hosted deployment requires persistent storage and your public origin:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# STRIPE_WEBHOOK_SECRET=
