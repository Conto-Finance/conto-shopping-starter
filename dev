#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-help}" in
  setup)
    "$ROOT/scripts/bootstrap.sh"
    exec "$ROOT/.runtime/commerce-agents/.venv/bin/python" "$ROOT/scripts/config.py" setup ;;
  doctor|start)
    if [[ ! -x "$ROOT/.runtime/commerce-agents/.venv/bin/python" ]]; then
      echo "Dependencies are missing. Run ./dev setup first." >&2; exit 1
    fi
    if [[ "$1" == doctor ]]; then
      exec "$ROOT/.runtime/commerce-agents/.venv/bin/python" "$ROOT/scripts/config.py" doctor
    fi
    exec "$ROOT/scripts/run.sh" ;;
  test) exec "$ROOT/scripts/test.sh" ;;
  build) exec "$ROOT/scripts/build.sh" ;;
  prepare-deploy) exec "$ROOT/scripts/prepare-deploy.sh" ;;
  help|--help|-h)
    cat <<'HELP'
Conto Shopping Starter
  ./dev setup           Install pinned dependencies and create a private .env
  ./dev doctor          Check local configuration without contacting services
  ./dev start           Start the shopping app at http://localhost:3000
  ./dev test            Run checkout, setup, and backend regression checks
  ./dev build           Build the shopping storefront
  ./dev prepare-deploy  Prepare the standalone Vercel application

Start with ./dev setup, fill in .env, then run ./dev doctor.
HELP
    ;;
  *) echo "Unknown command. Run ./dev help." >&2; exit 1 ;;
esac
